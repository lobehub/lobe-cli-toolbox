{
  "name": "@lobehub/commit-cli",
  "version": "2.20.1",
  "description": "Lobe Commit is a CLI tool that uses ChatGPT to generate Gitmoji-based commit messages",
  "keywords": [
    "ai",
    "git",
    "commit",
    "openai",
    "gpt",
    "gitmoji-cli",
    "git-commits",
    "chatgpt",
    "aicommit",
    "ai-commit"
  ],
  "homepage": "https://github.com/lobehub/lobe-cli-toolbox/tree/master/packages/lobe-commit",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-cli-toolbox/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-cli-toolbox.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "lobe": "dist/cli.js",
    "lobe-commit": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "link": "pnpm run build && npm link -f",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@octokit/rest": "^22.0.1",
    "ai": "^7.0.163",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "consola": "^3.4.2",
    "gpt-tokenizer": "^4.1.0",
    "ink": "^8.0.0",
    "lodash-es": "^4.18.1",
    "minimatch": "^11.0.4",
    "pangu": "^10.4.1",
    "react": "^19.3.1",
    "update-notifier": "^7.3.1",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@lobehub/cli-common": "workspace:*",
    "@lobehub/cli-ui": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "clean-package": "^2.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
