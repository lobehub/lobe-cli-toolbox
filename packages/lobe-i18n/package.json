{
  "name": "@lobehub/i18n-cli",
  "version": "1.28.0",
  "description": "Lobe i18n is a CLI tool that automate translate your i18n localization with AI",
  "keywords": [
    "ai",
    "i18n",
    "openai",
    "gpt"
  ],
  "homepage": "https://github.com/lobehub/lobe-cli-toolbox/tree/master/packages/lobe-i18n",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-cli-toolbox/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-cli-toolbox.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "lobe-i18n": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "link": "pnpm run build && npm link -f",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "ai": "^7.0.163",
    "chalk": "^6.0.1",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "consola": "^3.4.2",
    "cosmiconfig": "^10.0.1",
    "deepmerge": "^4.3.1",
    "dirty-json": "^0.9.2",
    "eld": "^2.1.0",
    "fast-deep-equal": "^3.1.3",
    "figures": "^6.1.0",
    "glob": "^14.0.3",
    "gpt-tokenizer": "^4.1.0",
    "gray-matter": "^4.0.3",
    "ink": "^8.0.0",
    "json-stable-stringify": "^1.3.0",
    "just-diff": "^6.0.2",
    "lodash-es": "^4.18.1",
    "p-map": "^7.1.1",
    "react": "^19.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@lobehub/cli-common": "workspace:*",
    "@lobehub/cli-ui": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/unist": "^3.0.3",
    "clean-package": "^2.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
