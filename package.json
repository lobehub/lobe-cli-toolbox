{
  "name": "lobe-cli-toolbox",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/lobehub/lobe-cli-toolbox",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-cli-toolbox/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-cli-toolbox.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm run lint && pnpm run type-check && pnpm run test",
    "dev": "pnpm -r --parallel dev",
    "dev:commit": "pnpm --filter @lobehub/commit-cli dev",
    "dev:i18n": "pnpm --filter @lobehub/i18n-cli dev",
    "dev:label": "pnpm --filter @lobehub/label-cli dev",
    "dev:seo": "pnpm --filter @lobehub/seo-cli dev",
    "dev:ui": "pnpm --filter @lobehub/cli-ui dev",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/*.config.ts\" \"*.config.{mjs,ts}\" vitest.shared.ts scripts",
    "lint:fix": "eslint --fix \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/*.config.ts\" \"*.config.{mjs,ts}\" vitest.shared.ts scripts",
    "lint:md": "remark . --quiet",
    "prepare": "husky",
    "prettier": "prettier -c --write \"**/**\"",
    "release": "multi-semantic-release --sequential-prepare",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "pnpm -r --parallel type-check"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@lobehub/lint": "^3.0.1",
    "@qiwi/multi-semantic-release": "^7.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/update-notifier": "^6.0.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "commitlint": "^21.2.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "remark-cli": "^12.0.1",
    "semantic-release": "^21.1.2",
    "tsdown": "^0.23.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0"
  }
}
